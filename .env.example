# TechPilot Environment Configuration
# Copy this file to .env and fill in appropriate values
# .env is never committed to the repository

# Application environment
ENVIRONMENT=development

# Backend configuration
BACKEND_HOST=localhost
BACKEND_PORT=8000
BACKEND_RELOAD=true

# Frontend configuration
FRONTEND_URL=http://localhost:5173

# Database configuration
DATABASE_URL=sqlite:///techpilot.db

# Logging
LOG_LEVEL=INFO

# Future: AI Provider configuration (Phase 4+)
# AI_PROVIDER=openai
# AI_MODEL=gpt-4
# AI_API_KEY=your-api-key-here

# Future: Security and authentication (Phase 5+)
# SECRET_KEY=your-secret-key-here
# JWT_ALGORITHM=HS256

# Future: Monetization configuration (Phase 14+)
# STRIPE_API_KEY=sk_test_example
# STRIPE_PUBLIC_KEY=pk_test_example
